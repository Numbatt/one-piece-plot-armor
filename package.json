{
  "name": "one-piece-plot-armor",
  "version": "1.0.0",
  "description": "A browser extension that hides One Piece spoilers across social media, tuned to exactly how far you are in the story. You tell it your episode; it blurs the stuff you haven't earned yet — manga leaks, future forms, deaths, twists — across Reddit, Twitter/X, Instagram, and more.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:llm": "tsx --env-file-if-exists=.env test/eval-llm.ts",
    "demo": "vite --config vite.demo.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Numbatt/one-piece-plot-armor.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Numbatt/one-piece-plot-armor/issues"
  },
  "homepage": "https://github.com/Numbatt/one-piece-plot-armor#readme",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "openai": "^6.49.0"
  }
}
