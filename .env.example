# Copy this file to `.env` and fill in your keys:  cp .env.example .env
# `.env` is gitignored; this example file is safe to commit as documentation.

# The classifier the extension ships today (PLAN §5.3). Required for
# `npm run eval:llm` and for the Haiku row of the scoreboard.
ANTHROPIC_API_KEY=

# --- The Cerebras vs GPU bake-off (demo/) -----------------------------------
# Both lanes run the SAME open weights (Gemma 4 31B, Apache 2.0). The only
# difference is the hardware underneath — that's the whole point of the demo.

# https://cloud.cerebras.ai — $5 in free credits on signup
CEREBRAS_API_KEY=

# https://api.together.ai — the GPU control lane
TOGETHER_API_KEY=
